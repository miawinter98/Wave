#!/usr/bin/env bash

echo "Pre-commit hook: csharpier format"

if
  ! dotnet csharpier check Wave/ wave.server/ --log-level=None
then
  echo "code is not formatted, please run csharpier"
  exit 1
fi

echo "Pre-commit hook: prettier format"

if 
  ! yarn --cwd wave.client/ exec prettier . --check
then
  echo "code is not formatted, please run prettier"
  exit 1
fi
